# Copy to .env.local and fill in. Never commit the real key.
ANTHROPIC_API_KEY=
# Optional: pin ONE model for every question. Leave unset for automatic routing
# (claude-haiku-4-5 for simple questions, claude-sonnet-5-5 for harder ones).
# CHAT_MODEL=claude-haiku-4-5

# --- Live chat via Telegram (visitor messages -> your Telegram; you reply there) ---
# 1) Create a bot with @BotFather and paste its token. 2) Message your bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...} below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Local dev: leave this empty (the site pulls replies from Telegram itself).
# Production (public https site): set any long random string, then register the webhook once:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" -d "url=https://YOUR-DOMAIN/api/telegram/webhook" -d "secret_token=<same string>"
TELEGRAM_WEBHOOK_SECRET=

# --- Admin page (/admin): manage AI key, Telegram bot, contacts and blog ---
# Both are required. ADMIN_SECRET signs the login session and encrypts keys saved in the admin page
# (changing it later makes already-saved keys unreadable, so enter them again).
ADMIN_PASSWORD=
ADMIN_SECRET=
# Optional: where admin data (config, contacts, usage, posts) is stored. Default ./.data (git-ignored).
# DATA_DIR=
